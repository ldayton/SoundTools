{
  "name": "dorego",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local vocal exercise studio with synchronized practice, MIDI, and video export.",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "npm run test:diagnostics && npm run test:offline-package && tsx --test tests/*.test.ts",
    "test:e2e": "tsx tests/e2e.ts",
    "format": "prettier --write .",
    "setup:browser": "playwright install chromium",
    "test:tempo": "tsx tests/tempo.e2e.ts",
    "test:glides": "tsx tests/glides.e2e.ts",
    "test:audio": "tsx tests/audio-playback.e2e.ts",
    "build:pages": "tsc --noEmit && vite build --mode pages --outDir dist-pages",
    "test:pages": "tsx tests/pages.e2e.ts",
    "export": "tsx scripts/export.ts",
    "test:lifecycle": "tsx tests/lifecycle.e2e.ts",
    "test:resilience": "node ../../scripts/test-resilience.cjs dorego",
    "test:offline": "tsx tests/offline.e2e.ts",
    "setup:browsers": "playwright install chromium firefox webkit",
    "test:desktop": "tsx tests/desktop.e2e.ts",
    "test:browsers": "tsx scripts/test-browsers.ts",
    "test:diagnostics": "npm run test --workspace=@ldayton/browser-diagnostics",
    "test:diagnostics-ui": "tsx tests/diagnostics.e2e.ts",
    "test:offline-package": "npm run test --workspace=@ldayton/browser-offline",
    "build:vercel": "node ../../scripts/build-vercel.cjs dorego"
  },
  "dependencies": {
    "@ldayton/browser-diagnostics": "*",
    "@ldayton/browser-offline": "*",
    "@tonejs/midi": "2.0.28",
    "express": "5.3.0",
    "lucide": "0.468.0",
    "playwright": "1.64.1",
    "tone": "15.1.22",
    "tsx": "4.23.15",
    "vite": "7.3.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "24.x"
  }
}
