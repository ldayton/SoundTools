{
  "name": "dorego",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local vocal exercise studio with synchronized practice, MIDI, and video export.",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "npm run test:diagnostics && npm run test:offline-package && npm run test:unit",
    "test:e2e": "tsx tests/e2e.ts",
    "format": "prettier --write .",
    "setup:browser": "playwright install chromium",
    "test:tempo": "tsx tests/tempo.e2e.ts",
    "test:glides": "tsx tests/glides.e2e.ts",
    "test:audio": "tsx tests/audio-playback.e2e.ts",
    "build:pages": "tsc --noEmit && npm run build:pages:bundle",
    "build:pages:bundle": "vite build --mode pages --outDir dist-pages",
    "test:pages": "tsx tests/pages.e2e.ts",
    "export": "tsx scripts/export.ts",
    "test:lifecycle": "tsx tests/lifecycle.e2e.ts",
    "test:resilience": "node ../../scripts/test-resilience.cjs dorego",
    "test:offline": "tsx tests/offline.e2e.ts",
    "setup:browsers": "playwright install chromium firefox webkit",
    "test:desktop": "tsx tests/desktop.e2e.ts",
    "test:browsers": "tsx scripts/test-browsers.ts",
    "test:diagnostics": "npm run test --workspace=@ldayton/browser-diagnostics",
    "test:diagnostics-ui": "tsx tests/diagnostics.e2e.ts",
    "test:offline-package": "npm run test --workspace=@ldayton/browser-offline",
    "build:vercel": "node ../../scripts/build-vercel.cjs dorego",
    "test:spelling": "tsx tests/spelling.e2e.ts",
    "test:layout": "node ../../scripts/test-practice-layout.cjs dorego",
    "test:workspace": "tsx tests/workspace.e2e.ts",
    "test:breathing": "tsx tests/breath-squares.e2e.ts",
    "test:breath-audio": "tsx tests/breath-audio.e2e.ts",
    "test:channels": "tsx tests/audio-channels.e2e.ts",
    "prepare:piano-trial": "python3 trials/piano/prepare.py",
    "trial:piano": "npm run prepare:piano-trial && vite --config trials/piano/vite.config.ts",
    "test:piano-trial": "tsc -p trials/piano/tsconfig.json && python3 trials/piano/verify.py && TEST_BROWSER=chromium tsx trials/piano/test.ts && TEST_BROWSER=firefox tsx trials/piano/test.ts && TEST_BROWSER=webkit tsx trials/piano/test.ts",
    "test:unit": "tsx --test tests/*.test.ts",
    "build:ci": "tsc --noEmit && node ../../scripts/ci/dorego-bundles.cjs"
  },
  "dependencies": {
    "@ldayton/browser-diagnostics": "*",
    "@ldayton/browser-offline": "*",
    "@tonejs/midi": "2.0.28",
    "express": "5.3.0",
    "lucide": "0.468.0",
    "playwright": "1.64.1",
    "tone": "15.1.22",
    "tsx": "4.23.15",
    "vite": "7.3.7",
    "@ldayton/ui": "0.1.0",
    "@mantine/core": "9.8.0",
    "@mantine/hooks": "9.8.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@ldayton/account": "0.1.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "soundglow": "*"
  },
  "engines": {
    "node": "24.x"
  }
}
