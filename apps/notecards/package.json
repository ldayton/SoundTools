{
  "name": "notecards",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4320 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "test:hymn-keys": "tsx tests/hymn-key.browser.ts",
    "test:workspace": "tsx tests/workspace.browser.ts",
    "test:browser": "tsx tests/browser.ts",
    "test:signatures": "tsx tests/key-signatures.browser.ts",
    "test:midi": "tsx tests/midi.browser.ts",
    "test:piano": "tsx tests/piano.browser.ts",
    "test:guitar": "tsx tests/guitar.browser.ts && npm run test:guitar-scales",
    "test:offline": "tsx tests/offline.browser.ts",
    "build:vercel": "node ../../scripts/build-vercel.cjs notecards",
    "test:diagnostics": "tsx tests/diagnostics.browser.ts",
    "test:notation": "tsx tests/notation.browser.ts",
    "import:hymns": "tsx scripts/import-hymns.ts",
    "test:sight": "tsx tests/sight-reading.browser.ts",
    "test:practice": "tsx tests/piano-practice.browser.ts",
    "test:navigation": "tsx tests/navigation.browser.ts",
    "test:recovery": "tsx tests/recovery.browser.ts && tsx tests/storage.browser.ts",
    "test:piano-audio": "tsx tests/piano-audio.browser.ts",
    "test:theory": "tsx tests/theory.browser.ts",
    "test:guitar-scales": "tsx tests/guitar-scales.browser.ts",
    "test:hymn-playback": "tsx tests/hymn-playback.browser.ts"
  },
  "dependencies": {
    "@ldayton/browser-diagnostics": "^0.2.0",
    "@ldayton/browser-offline": "^0.1.0",
    "abcjs": "6.5.2",
    "vexflow": "5.0.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
