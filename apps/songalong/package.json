{
  "name": "songalong",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4321 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test:hymn-keys": "tsx tests/hymn-key.browser.ts",
    "test:offline": "tsx tests/offline.browser.ts",
    "build:vercel": "node ../../scripts/build-vercel.cjs songalong",
    "test:diagnostics": "tsx ../../packages/music-practice/browser-tests/diagnostics.browser.ts",
    "test:sight": "tsx tests/sight-reading.browser.ts && tsx tests/hymn-recovery.browser.ts",
    "test:hymn-playback": "tsx tests/hymn-playback.browser.ts && tsx tests/hymn-passage.browser.ts",
    "test:hymn-recovery": "tsx tests/hymn-recovery.browser.ts",
    "test": "tsx --test tests/*.test.ts",
    "import:hymns": "tsx ../../packages/music-practice/scripts/import-hymns.ts",
    "test:split": "tsx ../../packages/music-practice/browser-tests/app-split.browser.ts",
    "test:sidebars": "tsx ../../packages/music-practice/browser-tests/sidebars.browser.ts"
  },
  "dependencies": {
    "@ldayton/music-practice": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
