;; Own AST walker, executed only inside our controlled LilyPond scaffold.
;; LilyPond already resolves pitches and scales tuplet leaf durations.
(define (music-length m)
  (ly:moment-main (ly:music-length m)))
(define (named? m name) (eq? (ly:music-property m 'name) name))
(define (events m name)
  (filter (lambda (x) (named? x name)) (ly:music-property m 'articulations)))
(define (digits m)
  (map (lambda (x) (ly:music-property x 'digit)) (events m 'FingeringEvent)))
(define (emit-note m at voice grace outer-digits outer-tie)
  (let* ((pitch (ly:music-property m 'pitch))
         (d (append (digits m) outer-digits))
         (duration (music-length m)))
    (format #t "ROW|~a|~a|~a|~a|~a|~a|~a|~a\n" voice (* 4 at)
      (if grace 0 (* 4 duration)) (+ 60 (ly:pitch-semitones pitch))
      (string-join (map number->string d) ",")
      (if (or outer-tie (pair? (events m 'TieEvent))) 1 0)
      (if grace 1 0) (* 4 duration))))
(define (dump-music m at voice grace)
  (let ((name (ly:music-property m 'name))
        (one (ly:music-property m 'element))
        (many (ly:music-property m 'elements)))
    (cond
      ((eq? name 'NoteEvent) (emit-note m at voice grace '() #f))
      ((eq? name 'EventChord)
        (let* ((notes (filter (lambda (x) (named? x 'NoteEvent)) many))
               (outside (append (digits m) (map (lambda (x) (ly:music-property x 'digit))
                 (filter (lambda (x) (named? x 'FingeringEvent)) many))))
               (tie (or (pair? (events m 'TieEvent))
                 (any (lambda (x) (named? x 'TieEvent)) many))))
          ;; A chord-level digit is not an explicit pitch attachment. Ambiguous
          ;; digits are recorded as zero; notes and eligibility inventory remain.
          (for-each (lambda (x) (emit-note x at voice grace
            (if (= (length notes) 1) outside (if (pair? outside) '(0) '())) tie)) notes)))
      ((eq? name 'SequentialMusic)
        (let ((time at)) (for-each (lambda (x)
          (dump-music x time voice grace)
          (if (not grace) (set! time (+ time (music-length x))))) many)))
      ((eq? name 'SimultaneousMusic)
        (let ((i 0)) (for-each (lambda (x)
          (dump-music x at (string-append voice "/" (number->string i)) grace)
          (set! i (+ i 1))) many)))
      ((eq? name 'GraceMusic) (dump-music one at voice #t))
      ((ly:music? one) (dump-music one at voice grace))
      ((pair? many) (ly:error "Unrecognized compound music ~a" name)))))
