;; Own written-pass traversal. Volta bodies and each printed alternative occur
;; once; source voices already contain the matching written accompaniment.
(define (music-length m)
  (let ((name (ly:music-property m 'name))
        (one (ly:music-property m 'element))
        (many (ly:music-property m 'elements)))
    (cond
      ((eq? name 'GraceMusic) 0)
      ((eq? name 'VoltaRepeatedMusic) (+ (music-length one) (apply + (map music-length many))))
      ((eq? name 'SequentialMusic) (apply + (map music-length many)))
      ((or (eq? name 'SimultaneousMusic) (eq? name 'EventChord))
        (if (null? many) 0 (apply max (map music-length many))))
      ((ly:music? one) (music-length one))
      (else (ly:moment-main (ly:music-length m))))))
(define original-dump-music dump-music)
(define (emit-note m at voice grace outer-digits outer-tie)
  (let* ((pitch (ly:music-property m 'pitch))
         (d (append (digits m) outer-digits))
         (duration (music-length m))
         (tie (or outer-tie (pair? (events m 'TieEvent))))
         (short (any (lambda (e) (member (format #f "~a" (ly:music-property e 'articulation-type))
                   '("staccato" "staccatissimo"))) (events m 'ArticulationEvent))))
    (format #t "ROW|~a|~a|~a|~a|~a|~a|~a|~a\n" voice (* 4 at)
      (if grace 0 (* (if (and short (not tie)) 2 4) duration))
      (+ 60 (ly:pitch-semitones pitch)) (string-join (map number->string d) ",")
      (if tie 1 0) (if grace 1 0) (* 4 duration))))
(define (dump-music m at voice grace)
  (cond ((eq? (ly:music-property m 'name) 'VoltaRepeatedMusic)
    (let* ((one (ly:music-property m 'element))
           (many (ly:music-property m 'elements))
           (time (+ at (music-length one))))
      (dump-music one at voice grace)
      (for-each (lambda (x) (dump-music x time voice grace)
        (set! time (+ time (music-length x)))) many)))
    ((eq? (ly:music-property m 'name) 'EventChord)
      (let* ((copy (ly:music-deep-copy m)) (many (ly:music-property copy 'elements))
             (arts (append (events copy 'ArticulationEvent)
               (filter (lambda (x) (named? x 'ArticulationEvent)) many))))
        (for-each (lambda (n) (if (named? n 'NoteEvent)
          (ly:music-set-property! n 'articulations (append (ly:music-property n 'articulations) arts)))) many)
        (original-dump-music copy at voice grace)))
    (else (original-dump-music m at voice grace))))
